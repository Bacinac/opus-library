# Copy to .env. Only infra bootstrap lives here — everything else (the address
# of OPUS · Downloads, library paths, quality, subtitle policy) is configured at
# runtime through the app's Settings page and stored in Postgres.

# What sessions are signed with. Required, and the SAME value in Library,
# Downloads and Player: a session any of them issues is read by all three. The
# backend refuses to start without it, or with one shorter than 32 characters.
#   python -c "import secrets; print(secrets.token_hex(32))"
OPUS_SESSION_KEY=

# Required only to create the first administrator on a new database. Keep this
# out of browsers and remove it after setup; 32+ random characters.
# OPUS_BOOTSTRAP_KEY=

# The database's own password, for the postgres service and the backend's
# connection alike. Required; hex keeps it safe inside a connection URL. On an
# existing database, set the role to it first:
#   docker compose exec -T postgres psql -U opus -d opus -c "ALTER ROLE opus PASSWORD '<value>'"
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# The domain the three modules share a session on, when they are published
# under one (opus.example.com and library.example.com share example.com).
# Unset keeps the cookie on the host that issued it — right for a LAN address.
# OPUS_COOKIE_DOMAIN=example.com

# Dev shapes (Vite dev server + HMR, uvicorn --reload). Leave unset for
# production: built UI (adapter-node + /api proxy) and plain uvicorn.
# OPUS_UI_TARGET=dev
# OPUS_DEV_RELOAD=1
# The hostname a tunnel publishes the dev server at, when it is opened from
# beyond the LAN; hot reload then runs over the tunnel's TLS as well.
# OPUS_DEV_HOST=opus-dev.example.com

# Container resource ceilings. Defaults fit the application services on the
# 32 GiB host; adjust only after measuring the relevant workload.
# OPUS_BACKEND_MEMORY_LIMIT=3g
# OPUS_BACKEND_PIDS_LIMIT=512
# OPUS_FRONTEND_MEMORY_LIMIT=512m
# OPUS_FRONTEND_PIDS_LIMIT=128
# OPUS_FACES_MEMORY_LIMIT=6g
# OPUS_FACES_PIDS_LIMIT=256
# OPUS_DATABASE_MEMORY_LIMIT=2g
# OPUS_DATABASE_PIDS_LIMIT=128

# Where the other OPUS modules answer, for the shell's module switcher. Unset
# means "not deployed here" and that module stays out of the switcher.
# VITE_OPUS_DOWNLOADS_URL=https://downloads.example.com

# UID/GID used by the Library application process. Writable volumes must be
# owned by this identity before switching an existing installation to non-root.
# OPUS_APP_UID=1000
# OPUS_APP_GID=1000
# First review `./deploy/prod.sh --prepare-volumes`; run it with `--apply`
# only in the planned rollout that enables the non-root backend.
# VITE_OPUS_PLAYER_URL=https://opus.example.com

# The libraries and the landing zone (compose named volumes). Unset falls back
# to the in-repo ./volumes/* folders.
#
# A music library on another machine, over NFS, read-only:
# OPUS_MUSIC_VOLUME_TYPE=nfs
# OPUS_MUSIC_VOLUME_OPTS=addr=192.0.2.11,ro,nfsvers=4
# OPUS_MUSIC_DEVICE=:/export/music
# OPUS_DOWNLOADS_DEVICE=/srv/opus-library/volumes/downloads
#
# Libraries on this machine — local binds, read-write:
# OPUS_MUSIC_VOLUME_TYPE=none
# OPUS_MUSIC_VOLUME_OPTS=bind
# OPUS_MUSIC_DEVICE=/mnt/media/music
# OPUS_MOVIES_VOLUME_TYPE=none
# OPUS_MOVIES_VOLUME_OPTS=bind
# OPUS_MOVIES_DEVICE=/mnt/media/movies
# OPUS_TV_VOLUME_TYPE=none
# OPUS_TV_VOLUME_OPTS=bind
# OPUS_TV_DEVICE=/mnt/media/television
# OPUS_VIDEO_VOLUME_TYPE=none
# OPUS_VIDEO_VOLUME_OPTS=bind
# OPUS_VIDEO_DEVICE=/mnt/media/video
# OPUS_DOWNLOADS_VOLUME_TYPE=none
# OPUS_DOWNLOADS_VOLUME_OPTS=bind
# OPUS_DOWNLOADS_DEVICE=/mnt/download

# The front proxies this box is reached through (for example a Cloudflare
# tunnel connector and a reverse proxy on the LAN).
# Only from them is a forwarded client address believed; every other caller is
# known by its own socket address.
# OPUS_TRUSTED_PROXIES=192.0.2.100,192.0.2.101
